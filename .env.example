# nexus_trader environment variables
# Copy this file to .env and fill in your actual values

# Gemini Flash API key (pre-market agents I0, I2, I3)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (post-market agent I9 -- llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here

# Telegram bot token (for trade alerts -- optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID (your personal or group chat ID -- optional)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
